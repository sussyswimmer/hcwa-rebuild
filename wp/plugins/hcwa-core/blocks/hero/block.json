{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "hcwa/hero",
	"title": "Hero",
	"category": "hcwa",
	"icon": "format-image",
	"description": "The first screen of the home page: heading, intro and two buttons.",
	"textdomain": "hcwa",
	"attributes": {
		"title": {
			"type": "string",
			"default": "",
			"role": "content"
		},
		"intro": {
			"type": "string",
			"default": "",
			"role": "content"
		}
	},
	"supports": {
		"html": false,
		"reusable": false
	},
	"editorScript": "file:./index.js",
	"render": "file:./render.php"
}
