{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "hcwa/news-latest",
	"title": "Latest news",
	"category": "hcwa",
	"icon": "megaphone",
	"description": "The three latest posts in this language, and a featured story on staging.",
	"textdomain": "hcwa",
	"attributes": {
		"featured": {
			"type": "boolean",
			"default": true
		},
		"limit": {
			"type": "integer",
			"default": 3
		}
	},
	"supports": {
		"html": false,
		"reusable": false
	},
	"editorScript": "file:./index.js",
	"render": "file:./render.php"
}
