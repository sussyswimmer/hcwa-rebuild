{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "hcwa/partner-wall",
	"title": "Partner wall",
	"category": "hcwa",
	"icon": "groups",
	"description": "Approved one-tone partner logos, shown once at least four are allowed.",
	"textdomain": "hcwa",
	"attributes": {
		"title": {
			"type": "string",
			"default": "",
			"role": "content"
		},
		"homeOnly": {
			"type": "boolean",
			"default": true
		},
		"limit": {
			"type": "integer",
			"default": 12
		}
	},
	"supports": {
		"html": false,
		"reusable": false
	},
	"editorScript": "file:./index.js",
	"render": "file:./render.php"
}
