{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "hcwa/image-slot",
	"title": "Approved image",
	"category": "hcwa",
	"icon": "format-image",
	"description": "An image that only shows when it is approved for the website. Until then staging shows the asset code from the visuals list (for example A2 · Hero · 4:5).",
	"textdomain": "hcwa-core",
	"attributes": {
		"id": { "type": "integer", "default": 0, "role": "content" },
		"code": { "type": "string", "default": "" },
		"labelVi": { "type": "string", "default": "" },
		"labelEn": { "type": "string", "default": "" },
		"ratio": { "type": "string", "enum": [ "1:1", "3:2", "4:3", "4:5", "16:9", "3:4" ], "default": "4:3" },
		"illustration": { "type": "boolean", "default": false },
		"eager": { "type": "boolean", "default": false },
		"sizes": { "type": "string", "default": "" }
	},
	"supports": { "html": false, "className": true, "reusable": false },
	"render": "file:./render.php"
}
