{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "hcwa/program-list",
	"title": "Program list",
	"category": "hcwa",
	"icon": "portfolio",
	"description": "Rows of projects and programs, active ones first.",
	"textdomain": "hcwa",
	"attributes": {
		"status": {
			"type": "string",
			"enum": [ "any", "active", "completed" ],
			"default": "any"
		},
		"limit": {
			"type": "integer",
			"default": 4
		},
		"centerId": {
			"type": "integer",
			"default": 0
		}
	},
	"usesContext": [ "postId", "postType" ],
	"supports": {
		"html": false
	},
	"editorScript": "file:./index.js",
	"render": "file:./render.php"
}
