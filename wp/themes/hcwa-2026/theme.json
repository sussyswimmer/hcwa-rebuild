{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": false,
		"color": {
			"custom": false,
			"customDuotone": false,
			"customGradient": false,
			"defaultDuotone": false,
			"defaultGradients": false,
			"defaultPalette": false,
			"duotone": [],
			"gradients": [],
			"palette": [
				{ "name": "Ink 900", "slug": "ink-900", "color": "#1D2131" },
				{ "name": "Ink 700", "slug": "ink-700", "color": "#434859" },
				{ "name": "Blue 700", "slug": "blue-700", "color": "#313188" },
				{ "name": "Blue 900", "slug": "blue-900", "color": "#20205A" },
				{ "name": "Sun 400", "slug": "sun-400", "color": "#FFC42E" },
				{ "name": "Sun 100", "slug": "sun-100", "color": "#FFF3D3" },
				{ "name": "Lime 50", "slug": "lime-50", "color": "#F7F2E9" },
				{ "name": "Lime 100", "slug": "lime-100", "color": "#EFE7DA" }
			]
		},
		"layout": {
			"contentSize": "720px",
			"wideSize": "1200px"
		},
		"shadow": {
			"defaultPresets": false,
			"presets": []
		},
		"spacing": {
			"customSpacingSize": false,
			"defaultSpacingSizes": false,
			"margin": true,
			"padding": true,
			"units": [ "px", "rem", "%" ],
			"spacingSizes": [
				{ "name": "4px", "slug": "s-1", "size": "4px" },
				{ "name": "8px", "slug": "s-2", "size": "8px" },
				{ "name": "12px", "slug": "s-3", "size": "12px" },
				{ "name": "16px", "slug": "s-4", "size": "16px" },
				{ "name": "24px", "slug": "s-5", "size": "24px" },
				{ "name": "32px", "slug": "s-6", "size": "32px" },
				{ "name": "48px", "slug": "s-7", "size": "48px" },
				{ "name": "64px", "slug": "s-8", "size": "64px" },
				{ "name": "96px", "slug": "s-9", "size": "96px" },
				{ "name": "128px", "slug": "s-10", "size": "128px" },
				{ "name": "Section", "slug": "section", "size": "clamp(64px, 8vw, 112px)" }
			]
		},
		"typography": {
			"customFontSize": false,
			"defaultFontSizes": false,
			"dropCap": false,
			"fluid": false,
			"fontStyle": false,
			"letterSpacing": false,
			"textTransform": false,
			"fontFamilies": [
				{
					"name": "Archivo HCWA",
					"slug": "display",
					"fontFamily": "\"Archivo HCWA\", \"Archivo HCWA Fallback\", \"Arial Narrow\", sans-serif",
					"fontFace": [
						{ "fontFamily": "Archivo HCWA", "fontStyle": "normal", "fontWeight": "600 700", "fontDisplay": "swap", "src": [ "file:./assets/dist/fonts/archivo-w78-600-700.woff2" ] }
					]
				},
				{
					"name": "Be Vietnam Pro",
					"slug": "body",
					"fontFamily": "\"Be Vietnam Pro\", \"Be Vietnam Pro Fallback\", system-ui, sans-serif",
					"fontFace": [
						{ "fontFamily": "Be Vietnam Pro", "fontStyle": "normal", "fontWeight": "400", "fontDisplay": "swap", "src": [ "file:./assets/dist/fonts/be-vietnam-pro-400.woff2" ] },
						{ "fontFamily": "Be Vietnam Pro", "fontStyle": "normal", "fontWeight": "500", "fontDisplay": "swap", "src": [ "file:./assets/dist/fonts/be-vietnam-pro-500.woff2" ] },
						{ "fontFamily": "Be Vietnam Pro", "fontStyle": "normal", "fontWeight": "600", "fontDisplay": "swap", "src": [ "file:./assets/dist/fonts/be-vietnam-pro-600.woff2" ] }
					]
				}
			],
			"fontSizes": [
				{ "name": "Meta (14)", "slug": "meta", "size": "0.875rem" },
				{ "name": "Small (15)", "slug": "small", "size": "0.9375rem" },
				{ "name": "Body (17)", "slug": "base", "size": "1.0625rem" },
				{ "name": "Lead (20)", "slug": "large", "size": "1.25rem" },
				{ "name": "Heading 4", "slug": "heading-4", "size": "1.375rem" },
				{ "name": "Heading 3", "slug": "heading-3", "size": "clamp(1.5rem, 1.3rem + 0.8vw, 1.875rem)" },
				{ "name": "Heading 2", "slug": "heading-2", "size": "clamp(1.875rem, 1.5rem + 1.6vw, 2.75rem)" },
				{ "name": "Heading 1", "slug": "heading-1", "size": "clamp(2.25rem, 1.6rem + 2.8vw, 3.75rem)" },
				{ "name": "Figure", "slug": "stat", "size": "clamp(2.5rem, 2rem + 2vw, 3.5rem)" }
			]
		}
	}
}
