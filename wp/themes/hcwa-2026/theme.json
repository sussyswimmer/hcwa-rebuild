{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": false,
		"color": {
			"custom": false,
			"customDuotone": false,
			"customGradient": false,
			"defaultDuotone": false,
			"defaultGradients": false,
			"defaultPalette": false,
			"duotone": [],
			"gradients": [],
			"palette": [
				{ "name": "Paper", "slug": "paper", "color": "#FBF8F3" },
				{ "name": "Surface", "slug": "surface", "color": "#FFFFFF" },
				{ "name": "Sunken", "slug": "sunken", "color": "#F3EEE6" },
				{ "name": "Ink", "slug": "ink", "color": "#1C2333" },
				{ "name": "Ink 2", "slug": "ink-2", "color": "#4A5265" },
				{ "name": "Ink 3", "slug": "ink-3", "color": "#5F6679" },
				{ "name": "Blue 900", "slug": "blue-900", "color": "#23236A" },
				{ "name": "Blue 700", "slug": "blue-700", "color": "#313188" },
				{ "name": "Blue 100", "slug": "blue-100", "color": "#ECECF7" },
				{ "name": "Sun 400", "slug": "sun-400", "color": "#FFC42E" },
				{ "name": "Sun 500", "slug": "sun-500", "color": "#F2B312" },
				{ "name": "Sun 100", "slug": "sun-100", "color": "#FFF4D6" }
			]
		},
		"layout": {
			"contentSize": "720px",
			"wideSize": "1200px"
		},
		"shadow": {
			"defaultPresets": false,
			"presets": [
				{ "name": "Card", "slug": "card", "shadow": "0 1px 2px rgba(28, 35, 51, .06), 0 4px 12px rgba(28, 35, 51, .06)" }
			]
		},
		"spacing": {
			"customSpacingSize": false,
			"defaultSpacingSizes": false,
			"margin": true,
			"padding": true,
			"units": [ "px", "rem", "%" ],
			"spacingSizes": [
				{ "name": "4px", "slug": "s-1", "size": "4px" },
				{ "name": "8px", "slug": "s-2", "size": "8px" },
				{ "name": "12px", "slug": "s-3", "size": "12px" },
				{ "name": "16px", "slug": "s-4", "size": "16px" },
				{ "name": "24px", "slug": "s-5", "size": "24px" },
				{ "name": "32px", "slug": "s-6", "size": "32px" },
				{ "name": "48px", "slug": "s-7", "size": "48px" },
				{ "name": "64px", "slug": "s-8", "size": "64px" },
				{ "name": "96px", "slug": "s-9", "size": "96px" },
				{ "name": "128px", "slug": "s-10", "size": "128px" },
				{ "name": "Section", "slug": "section", "size": "clamp(64px, 8vw, 112px)" }
			]
		},
		"typography": {
			"customFontSize": false,
			"defaultFontSizes": false,
			"dropCap": false,
			"fluid": false,
			"fontStyle": false,
			"letterSpacing": false,
			"textTransform": false,
			"fontFamilies": [
				{
					"name": "Fraunces",
					"slug": "display",
					"fontFamily": "\"Fraunces\", \"Iowan Old Style\", \"Georgia\", serif",
					"fontFace": [
						{
							"fontFamily": "Fraunces",
							"fontStyle": "normal",
							"fontWeight": "500 700",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/fraunces-vf.woff2" ]
						}
					]
				},
				{
					"name": "Be Vietnam Pro",
					"slug": "body",
					"fontFamily": "\"Be Vietnam Pro\", \"Segoe UI\", system-ui, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Be Vietnam Pro",
							"fontStyle": "normal",
							"fontWeight": "400",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/be-vietnam-pro-400.woff2" ]
						},
						{
							"fontFamily": "Be Vietnam Pro",
							"fontStyle": "normal",
							"fontWeight": "500",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/be-vietnam-pro-500.woff2" ]
						},
						{
							"fontFamily": "Be Vietnam Pro",
							"fontStyle": "normal",
							"fontWeight": "600",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/be-vietnam-pro-600.woff2" ]
						}
					]
				}
			],
			"fontSizes": [
				{ "name": "Meta (14)", "slug": "meta", "size": "0.875rem" },
				{ "name": "Small (15)", "slug": "small", "size": "0.9375rem" },
				{ "name": "Body (17)", "slug": "base", "size": "1.0625rem" },
				{ "name": "Lead (20)", "slug": "large", "size": "1.25rem" },
				{ "name": "Heading 4", "slug": "heading-4", "size": "1.375rem" },
				{ "name": "Heading 3", "slug": "heading-3", "size": "clamp(1.5rem, 1.3rem + 0.8vw, 1.875rem)" },
				{ "name": "Heading 2", "slug": "heading-2", "size": "clamp(1.875rem, 1.5rem + 1.6vw, 2.75rem)" },
				{ "name": "Heading 1", "slug": "heading-1", "size": "clamp(2.25rem, 1.6rem + 2.8vw, 3.75rem)" },
				{ "name": "Figure", "slug": "stat", "size": "clamp(2.5rem, 2rem + 2vw, 3.5rem)" }
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--paper)",
			"text": "var(--wp--preset--color--ink)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "var(--wp--preset--font-size--base)",
			"fontWeight": "400",
			"lineHeight": "1.65",
			"textTransform": "none"
		},
		"elements": {
			"heading": {
				"color": { "text": "var(--wp--preset--color--ink)" },
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--display)",
					"fontWeight": "600",
					"lineHeight": "1.2",
					"textTransform": "none"
				}
			},
			"h1": { "typography": { "fontSize": "var(--wp--preset--font-size--heading-1)", "letterSpacing": "-0.01em" } },
			"h2": { "typography": { "fontSize": "var(--wp--preset--font-size--heading-2)", "letterSpacing": "-0.01em" } },
			"h3": { "typography": { "fontSize": "var(--wp--preset--font-size--heading-3)" } },
			"h4": { "typography": { "fontSize": "var(--wp--preset--font-size--heading-4)" } },
			"link": {
				"color": { "text": "var(--wp--preset--color--blue-700)" }
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--sun-400)",
					"text": "var(--wp--preset--color--ink)"
				},
				"border": { "radius": "999px", "width": "0" },
				"spacing": {
					"padding": { "top": "12px", "right": "24px", "bottom": "12px", "left": "24px" }
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--body)",
					"fontSize": "var(--wp--preset--font-size--base)",
					"fontWeight": "600",
					"lineHeight": "1.25",
					"textTransform": "none"
				},
				":hover": {
					"color": { "background": "var(--wp--preset--color--sun-500)" }
				}
			},
			"caption": {
				"color": { "text": "var(--wp--preset--color--ink-2)" },
				"typography": { "fontSize": "var(--wp--preset--font-size--meta)" }
			}
		}
	}
}
