+/* ---------- H5a, proposal saigon-home: the focus areas as a gạch bông floor ----------
+   Four 20 cm cement tiles laid edge to edge, the corridor's runner seen from above: each area its own
+   block inlaid in cream on its own pigment (blocks.mjs gachTile). Tiles meet cream to cream, so no line
+   is drawn between two areas (D0.5); the floor's outer cream band is the plaster's own tone. The words
+   stand under (beside, on phones) each tile on the plaster, never on the pattern: ink-900 / ink-700 on
+   lime-100 as every sheet. The sun crosses the floor as the page scrolls (transform only). */
+.floor { position: relative; isolation: isolate; margin-top: clamp(40px, 5vw, 72px); }
+.floor__tiles { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 0; }
+.gach { --pig: var(--color-tile-ochre); --acc: var(--color-tile-indigo); position: relative; display: grid; grid-template-rows: auto 1fr; align-content: start; }
+.gach--protection { --pig: var(--color-tile-indigo); --acc: var(--color-tile-ochre); }
+.gach--family { --pig: var(--color-tile-jade); --acc: var(--color-tile-ochre); }
+.gach--policy { --pig: var(--color-tile-brick); --acc: var(--color-tile-indigo); }
+.gach__art { position: relative; z-index: 0; display: block; width: 100%; height: auto; aspect-ratio: 1; }
+.gach__ground { fill: var(--color-tile-cream); }
+.gach__med { fill: var(--pig); }
+.gach__frame { fill: none; stroke: var(--color-tile-cream); stroke-width: 2.5; }
+.gach__inlay { fill: var(--color-tile-cream); }
+.gach__heart, .gach__corner { fill: var(--acc); }
+/* worn pigment and cement speckle (one feTurbulence, rasterised once, never animated) */
+.gach__wear { fill: var(--color-tile-cream); opacity: 0.32; }
+/* Bậc thang's slots are narrow: drawn a little bolder so the stair reads at tile size. */
+.gach--policy .gach__inlay { stroke: var(--color-tile-cream); stroke-width: 9; stroke-linejoin: round; }
+/* The pigment is a little in the screen's shade until the sun reaches it. */
+.gach::after { content: ""; position: absolute; z-index: 1; left: 0; right: 0; top: 0; aspect-ratio: 1; pointer-events: none;
+  background: radial-gradient(closest-side, color-mix(in oklab, var(--color-sun-100) 46%, transparent), transparent); opacity: 0; transition: opacity 280ms var(--ease-out); }
+.gach__body { position: relative; z-index: 2; display: grid; gap: 10px; align-content: start; padding: clamp(20px, 2vw, 28px) clamp(16px, 1.6vw, 28px) 8px clamp(10px, 1.2vw, 18px); max-width: 34ch; }
+.gach__name { font-size: var(--fs-h3); }
+.gach__name a { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; padding-block: 10px; margin-block: -10px; color: var(--color-ink-900); text-decoration: none; }
+.gach__name a::after { content: ""; position: absolute; inset: 0; z-index: 3; }
+.gach__go { flex: none; color: var(--color-blue-700); translate: 0 4px; transition: translate var(--d-hover) var(--ease-out); }
+.gach__text { color: var(--color-ink-700); }
+@media (hover: hover) {
+  .gach:hover::after { opacity: 1; }
+  .gach:hover .gach__name a span { text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 0.16em; }
+  .gach:hover .gach__go { translate: 3px 4px; }
+}
+.gach:has(a:focus-visible) { outline: 3px solid var(--color-focus); outline-offset: 2px; }
+.gach a:focus-visible { outline: none; }
+/* The sun through the house's screen, on the floor: Hoa thị patches in sun-100 inside a soft pool, sliding
+   across the four tiles while the floor passes through the viewport (D4 CSS sun layer, transform only). */
+/* Light adds (screen): a patch on indigo turns a lighter, warmer blue, never a grey film over it. */
+.floor__sun { position: absolute; z-index: 1; left: 0; right: 0; top: 0; aspect-ratio: 4 / 1; pointer-events: none; overflow: hidden; mix-blend-mode: screen; }
+.floor__sun::before, .floor__sun::after { content: ""; position: absolute; inset: -30% -20%; }
+.floor__sun::before { background: var(--color-sun-200); opacity: 0.66;
+  mask: url("/svg/hole-hoa-thi.svg") 0 0 / 84px 84px repeat, radial-gradient(ellipse 21% 40% at 50% 50%, black 52%, transparent 68%); mask-composite: intersect;
+  transform: rotate(-4deg) skewX(-14deg) scaleY(1.1); }
+/* the warm pool the patches sit in: the sun on waxed cement */
+.floor__sun::after { background: radial-gradient(ellipse 26% 52% at 50% 50%, color-mix(in oklab, var(--color-sun-200) 22%, transparent), transparent 72%); }
+@keyframes floor-sun { from { translate: -34% 0; } to { translate: 34% 0; } }
+@keyframes floor-sun-v { from { translate: 0 -30%; } to { translate: 0 30%; } }
+@supports (animation-timeline: view()) {
+  html[data-motion="on"] .floor__sun::before, html[data-motion="on"] .floor__sun::after { animation: floor-sun linear both; animation-timeline: view(); animation-range: cover 10% cover 90%; }
+}
+@media (min-width: 600px) and (max-width: 1023px) {
+  .floor__tiles { grid-template-columns: repeat(2, minmax(0, 1fr)); row-gap: 8px; }
+  .floor__sun { aspect-ratio: 2 / 1; }
+}
+/* Phones: the runner turns to run down the page, each tile 128 px beside its words. */
+@media (max-width: 599px) {
+  .floor__tiles { grid-template-columns: minmax(0, 1fr); }
+  .gach { grid-template-columns: 128px minmax(0, 1fr); grid-template-rows: auto; column-gap: 16px; align-items: start; }
+  .gach__art { width: 128px; }
+  .gach::after { right: auto; width: 128px; }
+  .gach__body { padding: 14px 0 20px; }
+  .floor__sun { aspect-ratio: auto; bottom: 0; right: auto; width: 128px; }
+  .floor__sun::before { inset: -10% -60%; mask-size: 52px 52px, 100% 100%; }
+  @supports (animation-timeline: view()) { html[data-motion="on"] .floor__sun::before, html[data-motion="on"] .floor__sun::after { animation-name: floor-sun-v; } }
+}
+@media (prefers-reduced-motion: reduce) { .gach::after, .gach__go { transition: none; } }
