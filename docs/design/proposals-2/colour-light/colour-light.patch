+
+// PROPOSAL (colour and light): the focus areas as panes of kính màu, glazed the way Saigon stair windows and
+// transoms are: every part of the pane is glass. The block pattern (glsl/blocks.js numbers) is drawn by the
+// cames, dark steel lines along every hole and joint (blue-950); the holes take the area's own glass and its
+// accents, the field round them a pale glass of the same family, so the whole pane glows. One light runs from
+// the top-left (lifted toward sun-100) to the glass colour at the bottom-right. Colours are CSS custom
+// properties from tokens.css (--color-glass-*): no hex here.
+const GLASS_KEYS = ["amber", "teal", "blue", "green", "sky"];
+const start = (d) => d.match(/M(-?[\d.]+)[ ,](-?[\d.]+)/).slice(1).map(Number);
+// Which glass goes in a hole: kind, block column / row, the hole's subpath and its start point.
+const GLAZE = {
+  // Education: amber quatrefoils, the rosette pips in teal and sky by turns.
+  hoaThi: (c, r, i) => (i === 0 ? "amber" : (c + r + i) % 2 ? "teal" : "sky"),
+  // Protection: logo-blue diamonds, a ring of sky ones round an amber heart in every block.
+  matCao: (c, r, i, [x, y]) => {
+    const cell = mm(MAT_CAO.cell), h = mm(MAT_CAO.half);
+    const d = Math.abs(Math.round((x + h) / cell)) + Math.abs(Math.round(y / cell));
+    return d === 0 ? "amber" : d === 2 ? "sky" : "blue";
+  },
+  // Family: the rings close into circles where four blocks meet; most teal, every fourth amber, one green.
+  vongTron: (c, r, i, [x, y]) => {
+    const cx = c + (x > 0 ? 1 : 0), cy = r + (y > 0 ? 1 : 0), k = (cx * 2 + cy * 3) % 4;
+    return k === 0 ? "amber" : k === 3 ? "green" : "teal";
+  },
+  // Policy: green steps, climbing to sky and an amber top step.
+  bacThang: (c, r, i, [, y]) => (y < -60 ? "amber" : y < 0 ? "sky" : "green"),
+};
+// The field glass round the holes, per area: the area's colour, deep (the token toward its dark partner), so
+// the holes glow out of it the way sun through a pattern glows out of a deep pane.
+const FIELD = {
+  hoaThi: ["color-mix(in oklab, var(--color-glass-amber) 62%, var(--color-gold-700))", "var(--color-gold-700)"],
+  matCao: ["color-mix(in oklab, var(--color-glass-blue) 70%, var(--color-blue-700))", "var(--color-blue-900)"],
+  vongTron: ["color-mix(in oklab, var(--color-glass-teal) 70%, var(--color-blue-950))", "color-mix(in oklab, var(--color-glass-teal) 40%, var(--color-blue-950))"],
+  bacThang: ["color-mix(in oklab, var(--color-glass-green) 68%, var(--color-blue-950))", "color-mix(in oklab, var(--color-glass-green) 38%, var(--color-blue-950))"],
+};
+export function glassArt(kind, { cols = 2, rows = 2, cls = "glass-art", id = kind } = {}) {
+  const S = SIZE, W = cols * S, Hh = rows * S;
+  const subs = holes(kind).split("Z").filter(Boolean).map((d) => d + "Z");
+  const grad = (gid, k, lift, deep) => `<linearGradient id="${gid}" gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="${W}" y2="${Hh}">`
+    + `<stop offset="0" style="stop-color:color-mix(in oklab, var(--color-glass-${k}) ${lift}%, var(--color-sun-100))"/>`
+    + `<stop offset="1" style="stop-color:color-mix(in oklab, var(--color-glass-${k}) ${deep}%, var(--color-sun-100))"/></linearGradient>`;
+  const [f0, f1] = FIELD[kind];
+  const grads = GLASS_KEYS.map((k) => grad(`gl-${id}-${k}`, k, 64, 100)).join("")
+    + `<linearGradient id="gl-${id}-field" gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="${W}" y2="${Hh}"><stop offset="0" style="stop-color:${f0}"/><stop offset="1" style="stop-color:${f1}"/></linearGradient>`
+    // The pane is brightest where the sun is behind it and falls off toward its frame.
+    + `<radialGradient id="gl-${id}-v" cx="0.42" cy="0.36" r="0.75"><stop offset="0.35" style="stop-color:var(--color-blue-950);stop-opacity:0"/><stop offset="1" style="stop-color:var(--color-blue-950);stop-opacity:0.42"/></radialGradient>`;
+  const holesD = [], panes = [];
+  for (let r = 0; r < rows; r++) for (let c = 0; c < cols; c++) {
+    const t = `translate(${c * S + S / 2} ${r * S + S / 2})`;
+    for (const [i, d] of subs.entries()) {
+      panes.push(`<path transform="${t}" fill="url(#gl-${id}-${GLAZE[kind](c, r, i, start(d))})" d="${d}"/>`);
+      holesD.push(`<path transform="${t}" d="${d}"/>`);
+    }
+  }
+  const joints = [];
+  for (let c = 1; c < cols; c++) joints.push(`M${c * S} 0V${Hh}`);
+  for (let r = 1; r < rows; r++) joints.push(`M0 ${r * S}H${W}`);
+  return raw(`<svg class="${cls}" viewBox="0 0 ${W} ${Hh}" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false"><defs>${grads}</defs>`
+    + `<rect width="${W}" height="${Hh}" fill="url(#gl-${id}-field)"/><rect width="${W}" height="${Hh}" fill="url(#gl-${id}-v)"/>${panes.join("")}`
+    + `<g class="glass-art__came">${holesD.join("")}</g>`
+    + (joints.length ? `<path class="glass-art__joint" d="${joints.join("")}"/>` : "")
+    + `<rect class="glass-art__frame" width="${W}" height="${Hh}"/></svg>`);
+}
