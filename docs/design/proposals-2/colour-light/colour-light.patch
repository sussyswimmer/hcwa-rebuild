diff -ruN a/prototype/src/world/glsl/glass.js b/prototype/src/world/glsl/glass.js
--- a/prototype/src/world/glsl/glass.js	1970-01-01 00:00:00.000000000 +0000
+++ b/prototype/src/world/glsl/glass.js	2026-11-09 02:05:42.588885298 +0000
@@ -0,0 +1,126 @@
+import { Vector3, Vector4 } from "three";
+import { tok, vec } from "../colors.js";
+
+// PROPOSAL (colour and light): kính màu, the coloured glass of old Saigon transoms and stair windows, in
+// the corridor. Three openings, all analytic like the screen (05-DESIGN D6.1), no shadow maps, no textures:
+//   clerestory: a band of 30 cm panes above the screen (one pane per block column), lit by the sun (light 0).
+//               It lays a frieze of coloured rectangles along the door wall at head height that slides down
+//               the wall as the sun clock rises with the scroll. Frosted, untinted panes over Little Rose's bay.
+//   end window: a 5 × 7 pane window in the corridor's far end wall, lit by the soft daylight of the street
+//               beyond it (not the sun: its pool is soft and fades within 7 m, so it never reaches Little Rose).
+//   transoms:   each open unit's emblem glazed (glsl/doors.js gDoorTint): the unit's glass either side, HCWA's
+//               amber in the middle block. Little Rose's transom stays plain, untinted daylight.
+// Palette ids (uGlass[i]): 0 frost (untinted), 1 amber, 2 teal, 3 blue, 4 green, 5 sky. No red, no pink.
+export const GLASS_IDS = { frost: 0, amber: 1, teal: 2, blue: 3, green: 4, sky: 5 };
+const PALETTE = ["sky", "glass-amber", "glass-teal", "glass-blue", "glass-green", "glass-sky"];
+
+// The transmitted colour, normalised so its brightest channel is 1 (linear): what the glass does to white light.
+export function glassTint(name) {
+  const c = tok(name);
+  const m = Math.max(c.r, c.g, c.b);
+  return new Vector3(c.r / m, c.g / m, c.b / m);
+}
+export const glassPalette = () => PALETTE.map((n, i) => (i === 0 ? new Vector3(1, 1, 1) : glassTint(n)));
+// What the eye sees looking at the lit glass: the glass token itself, lifted (deep and saturated, not pastel).
+export const glassShow = (k = 1.3) => PALETTE.map((n, i) => (i === 0 ? vec(tok("sky")) : vec(tok(n)).multiplyScalar(k)));
+
+export const GLASS_GLSL = /* glsl */ `
+uniform vec3 uGlass[6];
+uniform vec4 uClere;   // plane x, y0, y1, z0
+uniform vec4 uClere2;  // z1, pane width, muntin width, rows (0: off)
+uniform vec4 uFrost;   // z0, z1 of the frosted run (Little Rose's bay and 0.6 m either side); empty when z1 <= z0
+uniform vec4 uEndWin;  // plane z, x0, x1, on (0/1)
+uniform vec4 uEndWin2; // y0, y1, cols, rows
+uniform vec4 uEndWin3; // muntin width, softness per metre, reach (m), strength
+uniform vec3 uEndL;    // toward the end window's daylight
+uniform vec4 uPool;    // strength, albedo share, saturation, white leak
+
+// The clerestory: two rows of panes, the upper row a half-step on from the lower, so the colours climb
+// diagonally along the corridor (amber, teal, blue, amber, green, sky).
+int paneId(vec2 id, float zc){
+  if (zc > uFrost.x && zc < uFrost.y) return 0;
+  float k = mod(id.x + 3. * id.y, 6.);
+  return k < .5 ? 1 : k < 1.5 ? 2 : k < 2.5 ? 3 : k < 3.5 ? 1 : k < 4.5 ? 4 : 5;
+}
+// The end window, as Saigon stair windows are glazed: one colour for the field (teal), a border of the logo
+// blue, an amber diamond with a sky heart in the middle, green where the diamond's points meet the border.
+int endId(vec2 id, float cols, float rows){
+  vec2 c = vec2(floor(cols * .5), floor(rows * .5));
+  if (id.x < .5 || id.y < .5 || id.x > cols - 1.5 || id.y > rows - 1.5) {
+    return (abs(id.x - c.x) < .5 || abs(id.y - c.y) < .5) ? 4 : 3;
+  }
+  float d = abs(id.x - c.x) + abs(id.y - c.y);
+  if (d < .5) return 5;
+  if (d < 1.5) return 1;
+  if (abs(d - 3.) < .5) return 1;
+  return 2;
+}
+vec3 glassC(int i){ return i == 0 ? uGlass[0] : i == 1 ? uGlass[1] : i == 2 ? uGlass[2] : i == 3 ? uGlass[3] : i == 4 ? uGlass[4] : uGlass[5]; }
+
+// The sun (L toward it) through the clerestory: rgb the glass colour, a its coverage (muntins and penumbra).
+vec4 clereLight(vec3 P, vec3 L){
+  if (uClere2.w < .5 || L.x > -1e-4) return vec4(0.);
+  float rows = uClere2.w;
+  float t = (uClere.x - P.x) / L.x;
+  if (t <= 0.) return vec4(0.);
+  vec3 Q = P + L * t;
+  if (Q.y < uClere.y - 0.05 || Q.y > uClere.z + 0.05) return vec4(0.);
+  float w = 0.0025 + 0.0093 * t * 0.6;
+  float band = smoothstep(w, -w, max(uClere.y - Q.y, Q.y - uClere.z)) * smoothstep(w, -w, max(uClere.w - Q.z, Q.z - uClere2.x));
+  if (band <= 0.) return vec4(0.);
+  vec2 cell = vec2(uClere2.y, (uClere.z - uClere.y) / rows);
+  vec2 g = vec2(Q.z - uClere.w, Q.y - uClere.y) / cell, id = floor(g), f = fract(g);
+  vec2 e = min(f, 1. - f) * cell;
+  float mu = smoothstep(-w, w, min(e.x, e.y) - uClere2.z * .5);
+  return vec4(glassC(paneId(id, uClere.w + (id.x + .5) * cell.x)), band * mu);
+}
+
+// The street's daylight through the end window: soft, fading with distance.
+vec4 endLight(vec3 P, vec3 N){
+  if (uEndWin.w < .5) return vec4(0.);
+  vec3 L = uEndL;
+  float n = dot(N, L);
+  if (n <= 0. || P.z < uEndWin.x + 0.005) return vec4(0.);
+  float t = (uEndWin.x - P.z) / L.z;
+  if (t <= 0. || t > uEndWin3.z) return vec4(0.);
+  vec3 Q = P + L * t;
+  if (Q.y < uEndWin2.x - 0.3 || Q.y > uEndWin2.y + 0.3) return vec4(0.);
+  float w = 0.01 + uEndWin3.y * t;
+  vec2 size = vec2(uEndWin.z - uEndWin.y, uEndWin2.y - uEndWin2.x), q = vec2(Q.x - uEndWin.y, Q.y - uEndWin2.x);
+  float rect = sdBox2(q - .5 * size, .5 * size);
+  float cov = smoothstep(w, -w, rect);
+  if (cov <= 0.) return vec4(0.);
+  vec2 cell = size / vec2(uEndWin2.z, uEndWin2.w), g = q / cell, id = clamp(floor(g), vec2(0.), vec2(uEndWin2.z, uEndWin2.w) - 1.), fr = fract(g);
+  vec2 e = min(fr, 1. - fr) * cell;
+  float mu = smoothstep(-w, w, min(e.x, e.y) - uEndWin3.x * .5);
+  float fall = 1. / (1. + 0.12 * t * t) * (1. - smoothstep(uEndWin3.z * .6, uEndWin3.z, t));
+  return vec4(glassC(endId(id, uEndWin2.z, uEndWin2.w)), cov * mu * sqrt(n) * fall * uEndWin3.w);
+}
+
+// A pool of coloured light on a surface whose lit colour is \`lit\`: the glass colour carried at the lit
+// surface's own brightness (a blue pool on ochre plaster stays blue, as the eye sees it), with a little of
+// the surface's own colour and a little white light leaking round the glass.
+float lumaG(vec3 c){ return dot(c, vec3(.2126, .7152, .0722)); }
+vec3 pool(vec3 lit, vec3 tint){
+  vec3 t = mix(vec3(1.), tint, uPool.z);
+  vec3 c = mix(t * (0.35 + 0.65 * sqrt(lumaG(lit))), lit * t, uPool.y);
+  return mix(c, lit, uPool.w) * uPool.x;
+}
+`;
+
+// Uniforms; clere/end/frost from sets/corridor.js. Off (on = 0) unless given, so a set without glass costs one branch.
+export function glassUniforms({ clere = null, end = null, frost = null, pool = [1, 0.25, 1, 0.12] } = {}) {
+  return {
+    uGlass: { value: glassPalette() },
+    uClere: { value: new Vector4(clere?.x ?? 0, clere?.y0 ?? 0, clere?.y1 ?? 0, clere?.z0 ?? 0) },
+    uClere2: { value: new Vector4(clere?.z1 ?? 0, clere?.pane ?? 0.3, clere?.muntin ?? 0.02, clere ? clere.rows ?? 1 : 0) },
+    uFrost: { value: new Vector4(frost?.[0] ?? 0, frost?.[1] ?? 0, 0, 0) },
+    uEndWin: { value: new Vector4(end?.z ?? 0, end?.x0 ?? 0, end?.x1 ?? 0, end ? 1 : 0) },
+    uEndWin2: { value: new Vector4(end?.y0 ?? 0, end?.y1 ?? 0, end?.cols ?? 1, end?.rows ?? 1) },
+    uEndWin3: { value: new Vector4(end?.muntin ?? 0.03, end?.soft ?? 0.03, end?.reach ?? 7, end?.strength ?? 0.8) },
+    uEndL: { value: new Vector3(...(end?.light ?? [0, 0.35, -1])).normalize() },
+    uPool: { value: new Vector4(...pool) },
+  };
+}
+
+export const glassColor = (name) => vec(tok(name));
