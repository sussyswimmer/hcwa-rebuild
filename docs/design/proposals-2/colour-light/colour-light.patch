+// PROPOSAL (colour and light): the corridor's đá mài, the Saigon terrazzo laid in colour. Same storage as
+// bakeTerrazzo (albedo relative to the cement, cement at TERRAZZO_CEMENT) so the surface shader is unchanged;
+// the cement's own hue is the world-terrazzo target. Denser and larger chips (4 to 14 mm over 2 × 2 m): white
+// marble most, then black, amber, teal, green, and a few logo blue. No red, no pink. One more 512² texture
+// (1.3 MB with mips), baked in slices after the corridor is requested.
+export const TERRAZZO_COLOUR_CEMENT = 0.4; // headroom for white marble chips (2.5 × the cement)
+export async function bakeTerrazzoColour({ slice = true } = {}) {
+  const C = TERRAZZO_COLOUR_CEMENT;
+  const cement = tok("terrazzo");
+  const chipTokens = [["lime-50", 0], ["ink-900", 0.15], ["glass-amber", 0.1], ["glass-teal", 0.15], ["glass-green", 0.2], ["glass-blue", 0.2]];
+  const chips = chipTokens.map(([name, lift]) => {
+    const ch = tok(name).lerp(cement, lift);
+    return [ch.r / cement.r, ch.g / cement.g, ch.b / cement.b];
+  });
+  const weights = [0.46, 0.62, 0.76, 0.86, 0.94, 1];
+  const r = rng(131), cloud = lattice(8, 149);
+  const data = new Uint8Array(N * N * 4);
+  for (let y = 0; y < N; y++) {
+    for (let x = 0; x < N; x++) {
+      const i = (y * N + x) * 4, k = C * (0.95 + 0.1 * cloud(x, y)) * 255;
+      data[i] = data[i + 1] = data[i + 2] = k; data[i + 3] = 255;
+    }
+    if (slice && y % 128 === 127) await yieldNow();
+  }
+  const count = 7000, contrast = 0.85;
+  for (let n = 0; n < count; n++) {
+    const cx = r() * N, cy = r() * N, rad = 1 + r() * r() * 2.6, pick = r(), sq = 0.6 + r() * 0.5, rot = r() * Math.PI;
+    const tint = chips[weights.findIndex((w) => pick <= w)];
+    const ca = Math.cos(rot), sa = Math.sin(rot);
+    for (let y = Math.floor(cy - rad - 2); y <= cy + rad + 2; y++) for (let x = Math.floor(cx - rad - 2); x <= cx + rad + 2; x++) {
+      // Crushed stone, not discs: a squashed, turned ellipse.
+      const dx = x + 0.5 - cx, dy = y + 0.5 - cy, u = dx * ca + dy * sa, v = (-dx * sa + dy * ca) / sq;
+      const cover = Math.min(1, Math.max(0, rad + 0.5 - Math.hypot(u, v))) * contrast;
+      if (cover <= 0) continue;
+      const i = (((y + N) % N) * N + ((x + N) % N)) * 4;
+      for (let ch = 0; ch < 3; ch++) data[i + ch] = Math.min(255, data[i + ch] * (1 - cover) + C * 255 * Math.min(tint[ch], 2.45) * cover);
+    }
+    if (slice && n % 2500 === 2499) await yieldNow();
+  }
+  return texture(data);
+}
