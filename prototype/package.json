{
  "name": "hcwa-prototype",
  "private": true,
  "type": "module",
  "description": "HCWA prototype: Bông gió (static, VI at /, EN at /en/)",
  "scripts": {
    "tokens": "node scripts/tokens-to-js.mjs",
    "svg": "node scripts/blocks-svg.mjs",
    "posters": "node scripts/render-posters.mjs",
    "predev": "npm run tokens",
    "dev": "vite",
    "prebuild": "npm run tokens",
    "build": "vite build",
    "prebuild:pages": "npm run tokens",
    "build:pages": "vite build --base=/hcwa-rebuild/",
    "preview": "vite preview",
    "test": "node --test \"test/*.test.mjs\"",
    "check:page": "node scripts/check-page.cjs http://localhost:4173",
    "check:hero": "node scripts/check-hero.cjs http://localhost:4173 ../qa/m1",
    "lcp": "node scripts/lcp.cjs 3 /",
    "check:sun": "node scripts/check-sun-crisp.mjs",
    "check:sunin": "node scripts/check-sunin.cjs http://localhost:4173 ../qa/m1/sunin",
    "check:contrast": "node scripts/light-contrast.mjs http://localhost:4173",
    "check:tiles": "node scripts/check-tiles.cjs http://localhost:4173",
    "check:links": "node scripts/check-links.mjs dist /",
    "check:links:pages": "node scripts/check-links.mjs dist /hcwa-rebuild/",
    "preexport:wp": "npm run tokens",
    "export:wp": "node scripts/export-wp.mjs"
  },
  "devDependencies": {
    "vite": "8.3.5"
  },
  "dependencies": {
    "gsap": "3.15.1",
    "lenis": "1.3.27",
    "three": "0.187.0"
  }
}
